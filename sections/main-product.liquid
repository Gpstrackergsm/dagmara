<section class="main-product-section" id="order-now">
  <div class="container main-product-container">
    
    <!-- Left Column: Interactive Product Gallery -->
    <div class="product-gallery">
      <div class="gallery-main-view">
        <span class="gallery-badge-save">SAVE $80 TODAY</span>
        <img id="gallery-main-img" src="{{ '01_hero_complete_kit_square.jpg' | asset_url }}" alt="DAGMARA 20V Chainsaw Kit" width="600" height="600" class="gallery-active-image">
      </div>

      <!-- Thumbnails Carousel (All 10 Real Angles Extracted from Video) -->
      <div class="gallery-thumbs" id="gallery-thumbs-list">
        <button type="button" class="thumb-btn active" onclick="theme.gallery.select(0, '{{ '01_hero_complete_kit_square.jpg' | asset_url }}')">
          <img src="{{ '01_hero_complete_kit_square.jpg' | asset_url }}" alt="Full Kit" width="70" height="70">
          <span class="thumb-label">Full Kit</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(1, '{{ '03_cutting_thick_log_square.jpg' | asset_url }}')">
          <img src="{{ '03_cutting_thick_log_square.jpg' | asset_url }}" alt="Wood Cutting" width="70" height="70">
          <span class="thumb-label">Cutting</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(2, '{{ '04_telescopic_high_reach_square.jpg' | asset_url }}')">
          <img src="{{ '04_telescopic_high_reach_square.jpg' | asset_url }}" alt="Telescopic Reach" width="70" height="70">
          <span class="thumb-label">High Reach</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(3, '{{ '02_chainsaw_profile_square.jpg' | asset_url }}')">
          <img src="{{ '02_chainsaw_profile_square.jpg' | asset_url }}" alt="Chainsaw Body" width="70" height="70">
          <span class="thumb-label">Profile</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(4, '{{ '05_12inch_dagmara_bar_square.jpg' | asset_url }}')">
          <img src="{{ '05_12inch_dagmara_bar_square.jpg' | asset_url }}" alt="12 Inch Bar" width="70" height="70">
          <span class="thumb-label">12" Bar</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(5, '{{ '06_easy_chain_assembly_square.jpg' | asset_url }}')">
          <img src="{{ '06_easy_chain_assembly_square.jpg' | asset_url }}" alt="Chain Assembly" width="70" height="70">
          <span class="thumb-label">Assembly</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(6, '{{ '07_toolless_tensioning_knob_square.jpg' | asset_url }}')">
          <img src="{{ '07_toolless_tensioning_knob_square.jpg' | asset_url }}" alt="Tool-Free Knob" width="70" height="70">
          <span class="thumb-label">Tensioner</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(7, '{{ '08_automatic_oiler_reservoir_square.jpg' | asset_url }}')">
          <img src="{{ '08_automatic_oiler_reservoir_square.jpg' | asset_url }}" alt="Auto Oiler" width="70" height="70">
          <span class="thumb-label">Auto Oiler</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(8, '{{ '09_brushless_motor_grip_square.jpg' | asset_url }}')">
          <img src="{{ '09_brushless_motor_grip_square.jpg' | asset_url }}" alt="Brushless Motor" width="70" height="70">
          <span class="thumb-label">Motor</span>
        </button>
        <button type="button" class="thumb-btn" onclick="theme.gallery.select(9, '{{ '10_telescopic_extension_pole_square.jpg' | asset_url }}')">
          <img src="{{ '10_telescopic_extension_pole_square.jpg' | asset_url }}" alt="Extension Pole" width="70" height="70">
          <span class="thumb-label">Pole Lock</span>
        </button>
      </div>

      <!-- Quick Benefit Bullets Under Media -->
      <div class="gallery-benefits-card">
        <div class="benefit-item">
          <span class="benefit-icon">⚡</span>
          <div>
            <strong>1000W Pure Brushless Engine</strong>
            <p>6,000 RPM high torque, 3x longer motor life, low vibration.</p>
          </div>
        </div>
        <div class="benefit-item">
          <span class="benefit-icon">🪓</span>
          <div>
            <strong>12-Inch (30cm) Cutting Bar</strong>
            <p>Cut big logs or thick hardwood branches with minimal effort.</p>
          </div>
        </div>
        <div class="benefit-item">
          <span class="benefit-icon">🛡️</span>
          <div>
            <strong>Tool-Free Chain Adjustment</strong>
            <p>Rotate the red tension dial to tighten the chain in seconds.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Product Purchasing & Offer Engine -->
    <div class="product-details">
      
      <!-- Brand & Rating -->
      <div class="product-meta-header">
        <span class="product-brand-tag">DAGMARA SMARTFLEXLI™ 20V</span>
        <div class="product-review-badge">
          <span class="stars">★★★★★</span>
          <span class="rating-val">4.9 / 5.0</span>
          <a href="#reviews" class="rating-count">(342 Reviews)</a>
        </div>
      </div>

      <!-- Title -->
      <h1 class="product-page-title">
        DAGMARA™ 2-in-1 Cordless Telescopic Chainsaw – 20V Brushless Motor, 12” (30cm) Bar &amp; High-Reach Extension Pole
      </h1>

      <!-- Pricing Block -->
      <div class="product-price-box">
        <div class="price-row">
          <span class="price-main" id="product-price">$99.00 USD</span>
          <span class="price-strikethrough" id="product-compare-price">$179.00 USD</span>
          <span class="price-savings-badge" id="product-discount-badge">Save $80 (44% OFF)</span>
        </div>
        <p class="installments-text">
          or 4 interest-free payments of <strong>$24.75</strong> with <span class="provider-pill">Klarna</span> / <span class="provider-pill">Afterpay</span>
        </p>
      </div>

      <!-- Scarcity Meter & Countdown Timer -->
      <div class="scarcity-card">
        <div class="scarcity-header">
          <span class="scarcity-indicator"><span class="pulse-dot-red"></span> Almost Sold Out:</span>
          <span class="scarcity-count">Only <strong>7 units</strong> left in this shipment</span>
        </div>
        <div class="scarcity-bar">
          <div class="scarcity-fill" style="width: 86%;"></div>
        </div>
        <div class="countdown-row">
          <span class="countdown-label">⏰ Flash Sale Ends In:</span>
          <div class="countdown-digits" id="flash-countdown">
            <span class="digit-box" id="cd-hours">02</span>h :
            <span class="digit-box" id="cd-mins">44</span>m :
            <span class="digit-box" id="cd-secs">18</span>s
          </div>
        </div>
      </div>

      <!-- Package Bundle Selectors -->
      <div class="bundle-selector-group">
        <label class="bundle-group-label">Select Your Kit Configuration:</label>
        
        <!-- Bundle 1: Standard Pro Kit -->
        <div class="bundle-option active" data-bundle="standard" data-price="99.00" data-compare="179.00" onclick="theme.bundles.select(this)">
          <input type="radio" name="bundle_choice" value="standard" checked>
          <div class="bundle-info">
            <div class="bundle-title-row">
              <strong class="bundle-name">Standard Pro Kit (Complete)</strong>
              <span class="bundle-price">$99.00 USD</span>
            </div>
            <p class="bundle-desc">Chainsaw + Telescopic Extension Pole + 1x 20V 4.5Ah Battery + Rapid Charger + 2 Extra Chains (3 Total) + Safety Gloves</p>
          </div>
        </div>

        <!-- Bundle 2: Double Battery Deluxe (Best Seller) -->
        <div class="bundle-option best-seller" data-bundle="double" data-price="129.00" data-compare="229.00" onclick="theme.bundles.select(this)">
          <span class="best-seller-tag">★ MOST POPULAR</span>
          <input type="radio" name="bundle_choice" value="double">
          <div class="bundle-info">
            <div class="bundle-title-row">
              <strong class="bundle-name">Double Battery Deluxe Kit</strong>
              <span class="bundle-price">$129.00 USD</span>
            </div>
            <p class="bundle-desc">Everything in Standard Kit + <strong>2x 20V 4.5Ah Batteries</strong> for all-day continuous yard work without charging downtime (Save $100)</p>
          </div>
        </div>

        <!-- Bundle 3: Landscaper Master Pack -->
        <div class="bundle-option" data-bundle="master" data-price="149.00" data-compare="269.00" onclick="theme.bundles.select(this)">
          <input type="radio" name="bundle_choice" value="master">
          <div class="bundle-info">
            <div class="bundle-title-row">
              <strong class="bundle-name">Landscaper Master Kit</strong>
              <span class="bundle-price">$149.00 USD</span>
            </div>
            <p class="bundle-desc">Everything in Deluxe + <strong>4 Extra Chains</strong> + Heavy-Duty Hard Storage Trunk Case (Save $120)</p>
          </div>
        </div>
      </div>

      <!-- Quantity & Add to Cart -->
      <div class="purchase-actions">
        <div class="quantity-wrapper">
          <label for="product-qty" class="sr-only">Quantity</label>
          <div class="quantity-selector">
            <button type="button" class="qty-btn" onclick="theme.product.decrementQty()">−</button>
            <input type="number" id="product-qty" value="1" min="1" max="10" readonly>
            <button type="button" class="qty-btn" onclick="theme.product.incrementQty()">+</button>
          </div>
        </div>

        <button type="button" id="main-add-to-cart" class="btn btn-primary btn-block main-buy-btn pulse-glow" onclick="theme.product.addToCart()">
          {% render 'icon', name: 'cart' %}
          <span>Add to Cart — Get Free Shipping</span>
        </button>
      </div>

      <!-- Instant 1-Click Buy / Cash on Delivery -->
      <a href="/checkout" class="btn btn-accent btn-block instant-checkout-btn">
        <span>⚡ Buy Now with 1-Click / Pay on Delivery</span>
      </a>

      <!-- Payment Icons & Trust Badges -->
      <div class="payment-trust-card">
        <div class="payment-methods">
          <span class="pay-tag">Visa</span>
          <span class="pay-tag">Mastercard</span>
          <span class="pay-tag">Apple Pay</span>
          <span class="pay-tag">Google Pay</span>
          <span class="pay-tag">PayPal</span>
          <span class="pay-tag">Cash on Delivery</span>
        </div>
        <div class="trust-guarantees">
          <div class="t-item">
            {% render 'icon', name: 'truck' %}
            <span>Free Express Delivery (2–3 Days)</span>
          </div>
          <div class="t-item">
            {% render 'icon', name: 'shield' %}
            <span>2-Year Manufacturer Warranty</span>
          </div>
          <div class="t-item">
            {% render 'icon', name: 'refresh' %}
            <span>30-Day Risk-Free Trial</span>
          </div>
        </div>
      </div>

      <!-- Accordion Specifications & Details -->
      <div class="product-accordion">
        
        <details class="accordion-item" open>
          <summary class="accordion-summary">
            <span>📦 What’s Included in the Box</span>
            {% render 'icon', name: 'chevron-down' %}
          </summary>
          <div class="accordion-content">
            <ul class="clean-list">
              <li>✔ <strong>1× DAGMARA™ 20V SmartFlexLi Chainsaw Unit</strong></li>
              <li>✔ <strong>1× 12-Inch (30cm) Deep Quenched Guide Bar</strong></li>
              <li>✔ <strong>1× Telescopic Extension Pole with Quick-Lock Coupler</strong></li>
              <li>✔ <strong>1× 20V Max 4.5Ah Li-Ion High-Capacity Battery Pack</strong></li>
              <li>✔ <strong>1× Rapid Desktop Charging Dock</strong></li>
              <li>✔ <strong>2× Extra Replacement Alloy Steel Saw Chains</strong> (3 Chains Total)</li>
              <li>✔ <strong>1× Heavy-Duty Cut-Resistant Work Gloves</strong></li>
              <li>✔ <strong>1× Illustrated User Manual &amp; Factory Box</strong></li>
            </ul>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-summary">
            <span>⚙️ Full Technical Specifications</span>
            {% render 'icon', name: 'chevron-down' %}
          </summary>
          <div class="accordion-content">
            <table class="specs-table">
              <tr><td>Motor Type</td><td>1000W Pure Copper Brushless Motor</td></tr>
              <tr><td>No-Load Speed</td><td>6,000 RPM High Torque</td></tr>
              <tr><td>Bar Length</td><td>12 Inches (30 cm)</td></tr>
              <tr><td>Cutting Capacity</td><td>Logs &amp; branches up to 30 cm diameter</td></tr>
              <tr><td>Battery Voltage</td><td>20V Max (18650-15Cell Matrix)</td></tr>
              <tr><td>Battery Capacity</td><td>4.5Ah High-Density Lithium-Ion</td></tr>
              <tr><td>Lubrication</td><td>Automatic Oil Reservoir System</td></tr>
              <tr><td>Chain Tensioner</td><td>Tool-Free Red Adjustment Knob</td></tr>
              <tr><td>Telescopic Pole</td><td>Quick-connect high reach extension</td></tr>
            </table>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-summary">
            <span>🚚 Shipping &amp; 30-Day Money-Back Guarantee</span>
            {% render 'icon', name: 'chevron-down' %}
          </summary>
          <div class="accordion-content">
            <p>Every order is dispatched within 24 hours with full tracking. Try the DAGMARA 20V Chainsaw in your own backyard for 30 days. If it doesn't effortlessly cut your wood and prune your high branches, simply return it for a 100% full refund—no questions asked.</p>
          </div>
        </details>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
