<section class="brushless-section" id="motor">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge badge-accent">ENGINEERED FOR EXTREME PERFORMANCE</span>
      <h2 class="section-title">Industrial Power in a Compact Cordless Body</h2>
      <p class="section-subtitle">
        Packed with commercial-grade components designed to outlast and outpower generic brushed mini saws.
      </p>
    </div>

    <div class="features-trio-grid">
      
      <!-- Feature 1: Brushless Motor -->
      <div class="feature-detail-card">
        <div class="card-image-wrap">
          <img src="{{ '09_brushless_motor_grip_square.jpg' | asset_url }}" alt="1000W Brushless Motor" width="400" height="400" loading="lazy">
        </div>
        <div class="card-content">
          <span class="feat-tag">1000W BRUSHLESS ENGINE</span>
          <h3>6,000 RPM Direct Drive Torque</h3>
          <p>Unlike old brushed motors with carbon friction, our electronic brushless stator generates zero sparks, 85% higher energy efficiency, and lasts over 10,000 hours of cutting.</p>
        </div>
      </div>

      <!-- Feature 2: Auto Oil Lubrication -->
      <div class="feature-detail-card">
        <div class="card-image-wrap">
          <img src="{{ '08_automatic_oiler_reservoir_square.jpg' | asset_url }}" alt="Automatic Oil Reservoir" width="400" height="400" loading="lazy">
        </div>
        <div class="card-content">
          <span class="feat-tag">BUILT-IN AUTO OILER</span>
          <h3>Continuous Chain Lubrication</h3>
          <p>Fill the top oil tank once and cut smoothly. Automatic oil delivery prevents overheating, reduces chain friction, and extends blade sharpness by up to 300%.</p>
        </div>
      </div>

      <!-- Feature 3: Tool-Free Quick Tensioner -->
      <div class="feature-detail-card">
        <div class="card-image-wrap">
          <img src="{{ '07_toolless_tensioning_knob_square.jpg' | asset_url }}" alt="Toolless Chain Tensioner" width="400" height="400" loading="lazy">
        </div>
        <div class="card-content">
          <span class="feat-tag">TOOL-FREE TENSIONING</span>
          <h3>Zero Tools Required</h3>
          <p>No loose screwdrivers or lost wrenches in the garden. Simply twist the oversized red tension knob to achieve perfect chain tautness in just 3 seconds.</p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brushless Engine",
  "settings": []
}
{% endschema %}
