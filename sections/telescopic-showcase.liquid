<section class="telescopic-section" id="features">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge badge-accent">TWO ESSENTIAL TOOLS IN ONE</span>
      <h2 class="section-title">Why Buy Two Tools When One Does It All?</h2>
      <p class="section-subtitle">
        Switch from an agile handheld ground chainsaw to a high-reach overhead pole pruner in under 10 seconds.
      </p>
    </div>

    <div class="dual-mode-grid">
      <!-- Mode 1: Handheld -->
      <div class="mode-card">
        <div class="mode-media">
          <img src="{{ '03_cutting_thick_log_square.jpg' | asset_url }}" alt="Handheld Chainsaw Mode" width="500" height="500" loading="lazy">
          <span class="mode-badge">MODE 1: HANDHELD CHAINSAW</span>
        </div>
        <div class="mode-body">
          <h3 class="mode-title">Heavy-Duty Ground Wood &amp; Log Cutting</h3>
          <p class="mode-description">
            Weighing under 4.5 lbs, this handheld power beast lets you slice through 12-inch hardwood logs, fallen branches, and firewood with one-handed ease and minimal fatigue.
          </p>
          <ul class="mode-features">
            <li>✔ <strong>12" Guide Bar:</strong> Perfect for firewood, lumber, and clearing fallen storm debris.</li>
            <li>✔ <strong>Anti-Kickback Guard:</strong> Protects hands from sawdust, chips, and sudden bounce.</li>
            <li>✔ <strong>Ergonomic Comfort Grip:</strong> Rubberized shock-absorbing handle for steady cutting.</li>
          </ul>
        </div>
      </div>

      <!-- Mode 2: Telescopic Pole -->
      <div class="mode-card">
        <div class="mode-media">
          <img src="{{ '04_telescopic_high_reach_square.jpg' | asset_url }}" alt="Telescopic Pole Mode" width="500" height="500" loading="lazy">
          <span class="mode-badge mode-badge-accent">MODE 2: OVERHEAD POLE SAW</span>
        </div>
        <div class="mode-body">
          <h3 class="mode-title">Safe High-Branch Trimming (Zero Ladders)</h3>
          <p class="mode-description">
            Snap the quick-connect extension pole into the handle to reach high limbs and overgrown canopy directly from the solid ground. Avoid dangerous falls and pricey tree-trimming contractors!
          </p>
          <ul class="mode-features">
            <li>✔ <strong>Quick-Lock Coupling:</strong> Sturdy aluminum telescopic shaft clicks into place securely.</li>
            <li>✔ <strong>Optimal Weight Balance:</strong> Motor weight remains balanced for effortless overhead control.</li>
            <li>✔ <strong>Dual Safety Trigger:</strong> Safely activate power from the extension handle trigger.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Telescopic Showcase",
  "settings": []
}
{% endschema %}
