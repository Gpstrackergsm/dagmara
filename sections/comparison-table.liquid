<section class="comparison-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge badge-accent">DIRECT COMPARISON</span>
      <h2 class="section-title">Why Smart Gardeners Choose DAGMARA™</h2>
      <p class="section-subtitle">
        See how the DAGMARA 20V compares against bulky gas chainsaws and cheap brushed mini saws.
      </p>
    </div>

    <div class="table-responsive">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="feature-col">Features &amp; Capabilities</th>
            <th class="highlight-col">
              <span class="col-badge">★ TOP CHOICE</span>
              <strong>DAGMARA™ 20V (12")</strong>
              <span class="col-price">$99.00 USD</span>
            </th>
            <th>
              <strong>Traditional Gas Saws</strong>
              <span class="col-price">$300 – $550+</span>
            </th>
            <th>
              <strong>Cheap 4"/6" Mini Saws</strong>
              <span class="col-price">$40 – $70</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="feature-title">2-in-1 Telescopic High Reach</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> Yes (Ground &amp; Overhead)</td>
            <td><span class="cross-icon">✖</span> Requires Ladder</td>
            <td><span class="cross-icon">✖</span> Ground Only</td>
          </tr>
          <tr>
            <td class="feature-title">Motor Type</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> 1000W Brushless (6,000 RPM)</td>
            <td>Gasoline 2-Stroke (High Fumes)</td>
            <td>Weak Brushed (Overheats)</td>
          </tr>
          <tr>
            <td class="feature-title">Cutting Capacity</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> Up to 30 cm (12 Inches)</td>
            <td>Up to 35 cm</td>
            <td>Only 10–15 cm</td>
          </tr>
          <tr>
            <td class="feature-title">Tool-Free Chain Tensioning</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> Quick Red Dial Knob</td>
            <td><span class="cross-icon">✖</span> Needs Wrench / Screwdriver</td>
            <td><span class="cross-icon">✖</span> Needs Screwdriver</td>
          </tr>
          <tr>
            <td class="feature-title">Automatic Chain Oiler</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> Built-in Reservoir Tank</td>
            <td><span class="check-icon">✔</span> Built-in (Messy Gas Mix)</td>
            <td><span class="cross-icon">✖</span> Manual Drop or None</td>
          </tr>
          <tr>
            <td class="feature-title">Weight &amp; Maneuverability</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> Ultra-Light (4.5 lbs)</td>
            <td>Very Heavy (14–18 lbs)</td>
            <td>Lightweight (2.5 lbs)</td>
          </tr>
          <tr>
            <td class="feature-title">Starting Mechanism</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> Push-Button Instant Start</td>
            <td><span class="cross-icon">✖</span> Painful Pull Cord</td>
            <td><span class="check-icon">✔</span> Push Button</td>
          </tr>
          <tr>
            <td class="feature-title">Spare Chains Included</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> 2 Extra Chains Free (3 Total)</td>
            <td><span class="cross-icon">✖</span> 1 Chain Only</td>
            <td>1 Chain Only</td>
          </tr>
          <tr>
            <td class="feature-title">Warranty &amp; Guarantee</td>
            <td class="highlight-cell"><span class="check-icon">✔</span> 2-Year Warranty + 30-Day Trial</td>
            <td>1-Year Limited</td>
            <td>No Warranty</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="text-center comparison-cta">
      <a href="#order-now" class="btn btn-primary btn-lg">
        <span>Upgrade to DAGMARA Today ($99)</span>
        {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": []
}
{% endschema %}
