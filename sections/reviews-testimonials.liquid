<section class="reviews-section" id="reviews">
  <div class="container">
    <div class="section-header text-center">
      <div class="review-aggregate">
        <div class="stars big-stars">★★★★★</div>
        <h2 class="section-title">Loved by 340+ Gardeners &amp; Landscapers</h2>
        <p class="aggregate-text"><strong>4.9 Out of 5.0 Rating</strong> Based on 342 Verified Customer Reviews</p>
      </div>
    </div>

    <!-- Review Cards Grid -->
    <div class="reviews-grid">
      
      <!-- Review 1 -->
      <div class="review-card">
        <div class="review-header">
          <div class="stars">★★★★★</div>
          <span class="verified-tag">{% render 'icon', name: 'check' %} Verified Buyer</span>
        </div>
        <h3 class="review-headline">"Saved me over $600 in tree surgeon costs in one afternoon!"</h3>
        <p class="review-body">
          "I had thick oak limbs hanging over my fence that I was terrified to climb a ladder to reach. The telescopic pole clicked on in seconds, and I pruned every single branch safely with both boots on the ground. The 1000W brushless motor sliced through 10-inch thick branches like hot butter."
        </p>
        <div class="reviewer-meta">
          <strong>Robert M.</strong>
          <span>Property Owner • Dallas, TX</span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="review-card">
        <div class="review-header">
          <div class="stars">★★★★★</div>
          <span class="verified-tag">{% render 'icon', name: 'check' %} Verified Buyer</span>
        </div>
        <h3 class="review-headline">"Lightweight, powerful, and no smelly gas fumes!"</h3>
        <p class="review-body">
          "Sold my old heavy Stihl gas saw after using this. No cord pulling, no carburetor cleaning, no mixing 2-stroke oil. Just click in the 20V battery and press the trigger. Cut up an entire fallen storm tree for my winter fire pit on one battery charge."
        </p>
        <div class="reviewer-meta">
          <strong>Michael K.</strong>
          <span>Homesteader • Oregon</span>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="review-card">
        <div class="review-header">
          <div class="stars">★★★★★</div>
          <span class="verified-tag">{% render 'icon', name: 'check' %} Verified Buyer</span>
        </div>
        <h3 class="review-headline">"The tool-free tensioner and auto-oiler make this 10/10."</h3>
        <p class="review-body">
          "Most cheap mini saws don't have an oil tank, so the chains burn out. The Dagmara has a built-in reservoir and the red tension knob means you never need a screwdriver. Also coming with 2 extra chains and gloves in the box is unbeatable value."
        </p>
        <div class="reviewer-meta">
          <strong>David L.</strong>
          <span>Landscape Contractor • North Carolina</span>
        </div>
      </div>

      <!-- Review 4 -->
      <div class="review-card">
        <div class="review-header">
          <div class="stars">★★★★★</div>
          <span class="verified-tag">{% render 'icon', name: 'check' %} Verified Buyer</span>
        </div>
        <h3 class="review-headline">"Easy enough for my 68-year-old father to use comfortably."</h3>
        <p class="review-body">
          "Got this for my dad who loves tending his fruit orchard but can no longer carry heavy equipment or pull starter cords. He was amazed at how balanced it feels even with the extension pole on. Highly recommended!"
        </p>
        <div class="reviewer-meta">
          <strong>Sarah T.</strong>
          <span>Verified Customer • Florida</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Testimonials",
  "settings": []
}
{% endschema %}
